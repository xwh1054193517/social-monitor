# ============================================================
# Social Monitor — 环境变量模板
# 使用方式：复制本文件为 `.env`（本地开发）或 `.env.production`
# （Docker Compose 部署），再填入真实值。所有值默认用 xxx 占位，
# 请勿将真实凭据写入本文件或提交到版本库。
# ============================================================

# --- Runtime ---
# development | production
NODE_ENV=xxx
# API 服务监听端口（默认 3001）
API_PORT=xxx
# Web 服务监听端口（默认 3000）
WEB_PORT=xxx

# --- Database (PostgreSQL) ---
# 连接串格式：postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=xxx

# --- Redis (BullMQ 队列 + 缓存) ---
REDIS_HOST=xxx
REDIS_PORT=xxx
# 本地开发通常留空；生产环境按需填写
REDIS_PASSWORD=xxx

# --- Telegram 客户端（消息监控，凭据来自 https://my.telegram.org）---
TELEGRAM_API_ID=xxx
TELEGRAM_API_HASH=xxx

# --- Telegram Bot（通知渠道，凭据来自 @BotFather）---
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_CHAT_ID=xxx

# --- QQ 官方机器人（https://q.qq.com）— QQ 群转发通知 ---
# AppID 为纯数字；AppSecret 在开放平台「开发设置」生成（只显示一次）。
# 未配置时 QQ 网关保持待机，不影响其他渠道。
QQ_APP_ID=xxx
QQ_APP_SECRET=xxx

# --- X / Twitter API（预留）---
X_API_KEY=xxx
X_API_KEY_SECRET=xxx
X_BEARER_TOKEN=xxx

# --- 加密密钥（AES-256-GCM，64 位 hex）---
# 用于加密 Telegram session 与通知渠道凭据。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=xxx

# --- 管理员登录（单账号）---
ADMIN_USERNAME=xxx
ADMIN_PASSWORD=xxx

# --- 认证（HMAC token）---
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=xxx
# token 有效期（秒，默认 2592000 = 30 天）
AUTH_TTL_SECONDS=xxx

# ============================================================
# 以下变量仅 Docker Compose 生产部署需要（docker-compose.prod.yml）
# ============================================================

# --- 数据库 / Redis（宿主机已运行的服务，容器经 host.docker.internal 访问）---
DB_HOST=xxx
DB_PORT=xxx
DB_NAME=xxx
DB_USER=xxx
DB_PASSWORD=xxx

# --- 公网入口（nginx 反向代理）---
NGINX_HTTP_PORT=xxx

# --- Web 子路径与 API 地址（均为构建期变量）---
NEXT_PUBLIC_BASE_PATH=xxx
NEXT_PUBLIC_API_BASE_URL=xxx
